# teamplay-talk 배포용 Caddy 설정 (자동 HTTPS 리버스 프록시)
#
# 도메인은 현재 임시 sslip.io (Droplet IP 기반). 정식 도메인 확정 시 교체.
167.71.219.241.sslip.io {
	# /mcp/ → /mcp 내부 rewrite.
	# 앱(Starlette)이 /mcp/ 를 /mcp 로 307 리다이렉트하는데, 프록시 뒤라
	# Location scheme이 http로 다운그레이드되어 httpx가 Authorization 헤더를
	# 떨군다(https→http 리다이렉트 보안 동작). rewrite로 리다이렉트 자체를 없앤다.
	@mcptrail path /mcp/
	rewrite @mcptrail /mcp
	reverse_proxy app:8000 {
		header_up X-Forwarded-Proto https
	}
}
