# 서버
HOST=0.0.0.0
PORT=8000

# (P1+) DB — DO Managed Postgres 또는 Supabase
DATABASE_URL=

# (P1+) 카카오 OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# 저장 토큰 암호화 키 (Fernet). DB에 들어가는 카카오 access/refresh 토큰을
# 앱 계층에서 암호화한다. `uv run python scripts/gen_token_key.py`로 생성해 붙여넣기.
# 미설정이면 평문 저장(개발 편의)이며, 운영 배포에는 반드시 설정할 것.
TOKEN_ENC_KEY=

# Google Drive 연동의 OAuth는 호스트(PlayMCP)가 대행하므로 서버 .env에
# Google 자격증명이 필요 없다. Client ID/Secret/Endpoint/Scope는 PlayMCP의
# MCP 등록 폼(인증 방식: OAuth)에 입력한다.
