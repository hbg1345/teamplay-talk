# 서버
HOST=0.0.0.0
PORT=8000

# (P1+) DB — DO Managed Postgres 또는 Supabase
DATABASE_URL=

# (P1+) 카카오 OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# 데일리 운영 자동화 (KST)
# 밤 체크인 폼: 전날/오늘/예정 todo 완료 여부 수집
DAILY_CHECKIN_ENABLED=true
DAILY_CHECKIN_HOUR_KST=21

# 아침 팀 리포트: 전날 체크인 반영 + 팀 상태 공지
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR_KST=9

# 개인별 오늘 할일 digest
DAILY_TASK_DIGEST_ENABLED=true
DAILY_TASK_DIGEST_HOUR_KST=9

# Google Drive 연동의 OAuth는 호스트(PlayMCP)가 대행하므로 서버 .env에
# Google 자격증명이 필요 없다. Client ID/Secret/Endpoint/Scope는 PlayMCP의
# MCP 등록 폼(인증 방식: OAuth)에 입력한다.
